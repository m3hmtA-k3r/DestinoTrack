@{
    ViewData["Title"] = L["Menu_Reports"].Value;
}

<div class="w-full">

    <!-- Sayfa başlığı -->
    <div class="flex items-center gap-4 p-6 mt-4 mb-8 rounded-xl bg-surface-container shadow-sm">
        <div class="w-12 h-12 rounded-xl bg-primary flex items-center justify-center text-on-primary shrink-0 shadow-sm">
            <span class="material-symbols-outlined text-[28px]">monitoring</span>
        </div>
        <div class="flex flex-col">
            <span class="font-label-md text-label-md text-primary uppercase">@L["AdminPanel"]</span>
            <h1 class="font-headline-md text-headline-md text-on-surface tracking-tight">@L["Menu_Reports"]</h1>
        </div>
    </div>

    @* SLA · zamanında teslim oranı — T3'ün kalan yarısı *@
    @await Component.InvokeAsync("AdminSlaSummary")

    @* Şubeler geciken kargoya göre — "nerede" sorusu, nedenlerden önce *@
    @await Component.InvokeAsync("AdminDelayedBranches")

    @* Personel teslimat performansı — "kim" sorusu, nedenlerden önce *@
    @await Component.InvokeAsync("AdminDeliveryPerformance")

    @* Yolda neden gecikti *@
    @await Component.InvokeAsync("AdminReasonBreakdown")

    @* Kapıda neden teslim edilemedi — ayrı tablo, ayrı soru *@
    @await Component.InvokeAsync("AdminReasonBreakdown", new { kind = "failure" })
</div>
