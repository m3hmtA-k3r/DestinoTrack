@model List<ResultCountryDto>
@{
    ViewData["Title"] = L["Countries"].Value;
}

<!-- Sayfa başlığı -->
<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-6 mt-4 mb-8 rounded-xl bg-surface-container shadow-sm">
    <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-primary flex items-center justify-center text-on-primary shrink-0 shadow-sm">
            <span class="material-symbols-outlined text-[28px]">public</span>
        </div>
        <div class="flex flex-col">
            <span class="font-label-md text-label-md text-primary uppercase">Konum Tanımları</span>
            <div class="flex items-center gap-2">
                <h1 class="font-headline-md text-headline-md lg:font-headline-lg lg:text-headline-lg text-on-surface tracking-tight">@L["Countries"]</h1>
                <span class="chip-neutral">@Model.Count</span>
            </div>
        </div>
    </div>
    <a asp-action="Create" class="btn-filled h-11 w-full sm:w-auto">
        <span class="material-symbols-outlined text-[20px]">add</span>
        <span>@L["NewCountry"]</span>
    </a>
</div>

<!-- Silme hatası (Controller'daki TempData["Error"]) -->
@if (TempData["Error"] is string error)
{
    <div class="flex items-center gap-3 p-4 mb-6 rounded-xl bg-error-container text-on-error-container">
        <span class="material-symbols-outlined text-[22px] shrink-0">error</span>
        <span class="font-body-sm text-body-sm">@error</span>
    </div>
}

<!-- Liste -->
<div class="m3-card overflow-hidden">
    @if (Model.Any())
    {
        <div class="overflow-x-auto">
            <table class="m3-table font-body-sm text-body-sm">
                <thead>
                    <tr>
                        <th class="py-3.5 px-6">@L["Country"] · @L["IsoCode"]</th>
                        <th class="py-3.5 px-4">@L["CurrencyCode"]</th>
                        <th class="py-3.5 px-4">@L["PhoneCode"]</th>
                        <th class="py-3.5 px-4">@L["LanguageCode"]</th>
                        <th class="py-3.5 px-6 text-right">@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var country in Model)
                    {
                        <tr>
                            <td class="py-4 px-6">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl bg-surface-container-high flex items-center justify-center text-primary font-bold text-[13px] shrink-0">
                                        @country.IsoCode
                                    </div>
                                    <span class="font-bold text-on-surface">@country.Name</span>
                                </div>
                            </td>
                            <td class="py-4 px-4">
                                <span class="chip-info">@country.CurrencyCode</span>
                            </td>
                            <td class="py-4 px-4 text-on-surface">@country.PhoneCode</td>
                            <td class="py-4 px-4">
                                <span class="chip-neutral uppercase">@country.LanguageCode</span>
                            </td>
                            <td class="py-4 px-6">
                                <div class="flex items-center justify-end gap-2">
                                    <a asp-action="Update" asp-route-id="@country.Id" title="@L["Update"]"
                                       class="p-2 rounded-xl bg-surface-container text-on-surface hover:bg-surface-variant transition-colors">
                                        <span class="material-symbols-outlined text-[18px]">edit</span>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@country.Id" method="post"
                                          onsubmit="return confirm('@L["ConfirmDelete"]');">
                                        <button type="submit" title="@L["Delete"]"
                                                class="p-2 rounded-xl bg-surface-container text-on-surface hover:bg-error-container hover:text-on-error-container transition-colors">
                                            <span class="material-symbols-outlined text-[18px]">delete</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <span class="material-symbols-outlined text-[48px] text-outline">public_off</span>
            <p class="font-body-sm text-body-sm text-on-surface-variant">@L["NoRecords"]</p>
            <a asp-action="Create" class="btn-tonal">
                <span class="material-symbols-outlined text-[20px]">add</span>
                <span>@L["NewCountry"]</span>
            </a>
        </div>
    }
</div>
