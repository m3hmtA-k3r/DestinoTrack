@model BranchIndexViewModel
@{
    // Transfer merkezi ekranında tür kilitli: çip yok, tür sütunu yok, başlık ve metinler değişir
    var locked = ViewBag.LockedType as BranchType?;
    var isTransfer = locked == BranchType.TransferCenter;
    var title = isTransfer ? L["TransferCenters"] : L["Branches"];
    var newLabel = isTransfer ? L["NewTransferCenter"] : L["NewBranch"];
    var searchHint = isTransfer ? L["SearchTransferCenter"] : L["SearchBranch"];
    var icon = isTransfer ? "hub" : "warehouse";
    ViewData["Title"] = title.Value;

    // Tür çipleri: seçili olan turuncu, diğerleri beyaz
    var chipBase = "inline-flex items-center gap-2 px-3 py-1.5 rounded-full font-label-md text-label-md transition-colors";
    var chipOn = chipBase + " bg-primary-container text-on-primary";
    var chipOff = chipBase + " bg-surface-container-lowest text-on-surface-variant shadow-[0_1px_8px_rgba(0,0,0,0.04)] hover:bg-surface-container-high";
}

<!-- Sayfa başlığı -->
<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-6 mt-4 mb-8 rounded-xl bg-surface-container shadow-sm">
    <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-xl bg-primary flex items-center justify-center text-on-primary shrink-0 shadow-sm">
            <span class="material-symbols-outlined text-[28px]">@icon</span>
        </div>
        <div class="flex flex-col">
            <span class="font-label-md text-label-md text-primary uppercase">@L["Menu_BranchesWarehouses"]</span>
            <div class="flex items-center gap-2">
                <h1 class="font-headline-md text-headline-md lg:font-headline-lg lg:text-headline-lg text-on-surface tracking-tight">@title</h1>
                <span class="chip-neutral">@Model.Branches.TotalCount</span>
            </div>
        </div>
    </div>
    <a asp-action="Create" class="btn-filled h-11 w-full sm:w-auto">
        <span class="material-symbols-outlined text-[20px]">add</span>
        <span>@newLabel</span>
    </a>
</div>

<!-- Hata bandı (Controller'daki TempData["Error"]) -->
@if (TempData["Error"] is string error)
{
    <div class="flex items-center gap-3 p-4 mb-6 rounded-xl bg-error-container text-on-error-container">
        <span class="material-symbols-outlined text-[22px] shrink-0">error</span>
        <span class="font-body-sm text-body-sm">@error</span>
    </div>
}

<!-- Filtre: tür çipleri (yalnızca şube ekranında) + arama. İkisi de POST ile gider, seçim oturumda saklanır -->
<div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-6">

    @if (locked is null)
    {
        <form asp-action="Filter" method="post" class="flex flex-wrap items-center gap-2">
            <input type="hidden" name="q" value="@Model.Search" />

            <button type="submit" name="branchType" value=""
                    class="@(Model.SelectedType == null ? chipOn : chipOff)">
                <span>@L["All"]</span>
                <span class="opacity-70">@Model.TotalBranchCount</span>
            </button>

            @foreach (var filter in Model.TypeFilters)
            {
                <button type="submit" name="branchType" value="@filter.BranchType"
                        class="@(Model.SelectedType == filter.BranchType ? chipOn : chipOff)">
                    <span>@L["BranchType_" + filter.BranchType]</span>
                    <span class="opacity-70">@filter.BranchCount</span>
                </button>
            }
        </form>
    }
    else
    {
        <div></div>
    }

    <form asp-action="Filter" method="post" class="flex items-center gap-2 w-full lg:w-auto">
        <input type="hidden" name="branchType" value="@(locked is null ? Model.SelectedType : null)" />
        <div class="relative flex-1 lg:w-72">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-secondary text-[20px] pointer-events-none">search</span>
            <input type="search" name="q" value="@Model.Search" placeholder="@searchHint"
                   class="field-input pl-10" autocomplete="off" data-clear-submit />
        </div>
        <button type="submit" class="btn-tonal shrink-0">@L["Search"]</button>
    </form>
</div>

<!-- Liste -->
<div class="m3-card overflow-hidden">
    @if (Model.Branches.Items.Count > 0)
    {
        <div class="overflow-x-auto">
            <table class="m3-table font-body-sm text-body-sm">
                <thead>
                    <tr>
                        <th class="py-3.5 px-6">@L["BranchName"]</th>
                        @if (locked is null)
                        {
                            <th class="py-3.5 px-4">@L["BranchType"]</th>
                        }
                        <th class="py-3.5 px-4">@L["CityName"]</th>
                        <th class="py-3.5 px-4 text-right">@L["Capacity"]</th>
                        <th class="py-3.5 px-4 text-right">@L["DockCount"]</th>
                        <th class="py-3.5 px-6 text-right">@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var branch in Model.Branches.Items)
                    {
                        <tr>
                            <td class="py-4 px-6">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl bg-surface-container-high flex items-center justify-center text-primary shrink-0">
                                        <span class="material-symbols-outlined text-[20px]">@icon</span>
                                    </div>
                                    <div class="flex flex-col">
                                        <span class="font-bold text-on-surface">@branch.Name</span>
                                        <span class="font-body-sm text-body-sm text-on-surface-variant">@branch.Code</span>
                                    </div>
                                </div>
                            </td>
                            @if (locked is null)
                            {
                                <td class="py-4 px-4">
                                    <span class="chip-neutral">@L["BranchType_" + branch.BranchType]</span>
                                </td>
                            }
                            <td class="py-4 px-4">
                                <span class="chip-info">@branch.CityName</span>
                                <span class="font-body-sm text-body-sm text-on-surface-variant">· @branch.CountryName</span>
                            </td>
                            <td class="py-4 px-4 text-right text-on-surface">@branch.Capacity</td>
                            <td class="py-4 px-4 text-right text-on-surface">@branch.DockCount</td>
                            <td class="py-4 px-6">
                                <div class="flex items-center justify-end gap-2">
                                    <a asp-action="Update" asp-route-id="@branch.Id" title="@L["Update"]"
                                       class="p-2 rounded-xl bg-surface-container text-on-surface hover:bg-surface-variant transition-colors">
                                        <span class="material-symbols-outlined text-[18px]">edit</span>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@branch.Id" method="post"
                                          onsubmit="return confirm('@L["ConfirmDelete"]');">
                                        <button type="submit" title="@L["Delete"]"
                                                class="p-2 rounded-xl bg-surface-container text-on-surface hover:bg-error-container hover:text-on-error-container transition-colors">
                                            <span class="material-symbols-outlined text-[18px]">delete</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("_Pagination", Model.Branches)
    }
    else if (Model.IsFiltered && (locked is null || !string.IsNullOrWhiteSpace(Model.Search)))
    {
        <!-- Filtreye uyan tesis yok -->
        <div class="empty-state">
            <span class="material-symbols-outlined text-[48px] text-outline">search_off</span>
            <p class="font-body-sm text-body-sm text-on-surface-variant">@L["NoResults"]</p>
            <form asp-action="Filter" method="post">
                <input type="hidden" name="branchType" value="" />
                <input type="hidden" name="q" value="" />
                <button type="submit" class="btn-tonal">
                    <span class="material-symbols-outlined text-[20px]">filter_alt_off</span>
                    <span>@L["ClearFilter"]</span>
                </button>
            </form>
        </div>
    }
    else
    {
        <!-- Bu ekranın türünde hiç tesis yok -->
        <div class="empty-state">
            <span class="material-symbols-outlined text-[48px] text-outline">@icon</span>
            <p class="font-body-sm text-body-sm text-on-surface-variant">@L["NoRecords"]</p>
            <a asp-action="Create" class="btn-tonal">
                <span class="material-symbols-outlined text-[20px]">add</span>
                <span>@newLabel</span>
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Arama kutusu boşaltılınca filtre kendiliğinden kalkar
        document.querySelectorAll('[data-clear-submit]').forEach(input => {
            input.addEventListener('input', () => {
                if (input.value === '') {
                    input.form.submit();
                }
            });
        });
    </script>
}
