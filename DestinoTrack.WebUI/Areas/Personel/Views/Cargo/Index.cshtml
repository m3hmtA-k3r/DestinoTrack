@model CargoListViewModel
@{
    ViewData["Title"] = L["Menu_BranchCargos"].Value;
    ViewData["PanelLabel"] = L["BranchPanel"].Value;

    // Kargo kabulü gişede olur: "Yeni Kargo" yalnız bu panelde.
    ViewData["ShowCreate"] = true;

    // Yön çipi de yalnız burada anlamlı — kapsam şube olduğunda
    // CargoRepository.Scoped gelen/çıkan ayrımını gerçekten süzüyor.
    ViewData["ShowDirection"] = true;
}

@await Html.PartialAsync("_CargoList", Model)
