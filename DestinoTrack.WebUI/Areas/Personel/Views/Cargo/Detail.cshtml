@using DestinoTrack.DTO.DTOs.CargoDtos
@model CargoDetailDto
@{
    ViewData["Title"] = Model.TrackCode;

    // Üst etiket: şube panelinde "Şube Kargoları" yazar
    ViewData["Caption"] = L["Menu_BranchCargos"].Value;

    // Etiketi basan şubedir: düğme bu ekranda açılıyor
    ViewData["CanPrintLabel"] = true;
}

@await Html.PartialAsync("_CargoDetail", Model)
