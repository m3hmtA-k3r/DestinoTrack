@model PersonelHomeViewModel
@{
    ViewData["Title"] = L["Menu_DailySummary"].Value;
}

<div class="w-full">

    <!-- Sayfa başlığı -->
    <div class="flex items-center gap-4 p-6 mt-4 mb-8 rounded-xl bg-surface-container shadow-sm">
        <div class="w-12 h-12 rounded-xl bg-primary flex items-center justify-center text-on-primary shrink-0 shadow-sm">
            <span class="material-symbols-outlined text-[28px]">insights</span>
        </div>
        <div class="flex flex-col">
            <span class="font-label-md text-label-md text-primary uppercase">@L["BranchPanel"]</span>
            <h1 class="font-headline-md text-headline-md text-on-surface tracking-tight">@L["Menu_DailySummary"]</h1>
        </div>
    </div>

    @if (Model.OnlyCourier)
    {
        @* Kuryenin günü şubenin günü değil: tek işi kendi turu, kartın tamamı oraya götürüyor *@
        <a asp-controller="Delivery" asp-action="Index"
           class="m3-card p-6 flex items-center gap-4 hover:bg-surface-container-high transition-colors">
            <div class="w-12 h-12 rounded-xl bg-primary-container flex items-center justify-center text-on-primary shrink-0">
                <span class="material-symbols-outlined text-[24px]">two_wheeler</span>
            </div>
            <span class="font-headline-sm text-headline-sm text-on-surface flex-1 min-w-0">@L["Menu_MyDeliveryList"]</span>
            <span class="material-symbols-outlined text-on-surface-variant">arrow_forward</span>
        </a>
    }
    else
    {
        @* Günlük özet kartları — sayıları servisten kendi alıyor *@
        @await Component.InvokeAsync("BranchDailySummary")

        @* Şubede en son yazılan hareketler *@
        @await Component.InvokeAsync("BranchRecentMovements")
    }

</div>
