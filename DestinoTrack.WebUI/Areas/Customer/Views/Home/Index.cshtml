@{
    ViewData["Title"] = L["Menu_Overview"].Value;
}

<div class="w-full">

    <div class="flex items-center gap-4 p-6 mt-4 mb-8 rounded-xl bg-surface-container shadow-sm">
        <div class="w-12 h-12 rounded-xl bg-primary flex items-center justify-center text-on-primary shrink-0 shadow-sm">
            <span class="material-symbols-outlined text-[28px]">dashboard</span>
        </div>
        <div class="flex flex-col">
            <span class="font-label-md text-label-md text-primary uppercase">@L["CustomerPanel"]</span>
            <h1 class="font-headline-md text-headline-md text-on-surface tracking-tight">@L["Menu_Overview"]</h1>
            <span class="font-body-sm text-body-sm text-on-surface-variant">@L["Welcome"]</span>
        </div>
    </div>

    @await Component.InvokeAsync("CustomerSummary")

    @await Component.InvokeAsync("CustomerTimeline")


</div>
