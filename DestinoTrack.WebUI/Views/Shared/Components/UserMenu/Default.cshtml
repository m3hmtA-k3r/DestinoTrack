@model UserCardDto

<!-- Hesap menüsü — UserMenuViewComponent · Default -->
<!-- <details>: JavaScript'siz açılır menü — düğmeye tıklayınca açılır / kapanır -->
<details class="relative">
    <summary class="flex items-center gap-2 p-1 sm:pr-3 rounded-xl cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-surface-container-high transition-colors" aria-label="@L["AccountMenu"]">
        <span class="w-8 h-8 rounded-full bg-primary flex items-center justify-center font-headline-sm text-label-md text-on-primary">@Model.Initials</span>
        <span class="hidden sm:block max-w-40 truncate font-body-sm text-body-sm text-on-surface">@Model.FullName</span>
        <span class="material-symbols-outlined text-[20px] text-on-surface-variant">expand_more</span>
    </summary>

    <div class="absolute right-0 mt-2 w-56 p-2 rounded-xl bg-surface-container-lowest shadow-[0_4px_16px_rgba(0,0,0,0.08)] z-50">
        <a asp-area="" asp-controller="Account" asp-action="Profile" class="flex items-center gap-3 px-3 py-2 rounded-lg font-body-sm text-body-sm text-on-surface hover:bg-surface-container-high transition-colors">
            <span class="material-symbols-outlined text-[20px]">person</span>
            <span>@L["MyAccount"]</span>
        </a>

        @if (Model.IsAdmin)
        {
            <a asp-area="Admin" asp-controller="City" asp-action="Index" class="flex items-center gap-3 px-3 py-2 rounded-lg font-body-sm text-body-sm text-on-surface hover:bg-surface-container-high transition-colors">
                <span class="material-symbols-outlined text-[20px]">admin_panel_settings</span>
                <span>@L["AdminPanel"]</span>
            </a>
        }

        <!-- Çıkış: POST + antiforgery (form tag helper token'ı kendisi ekler) -->
        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="w-full flex items-center gap-3 px-3 py-2 rounded-lg font-body-sm text-body-sm text-on-surface hover:bg-error-container hover:text-on-error-container transition-colors">
                <span class="material-symbols-outlined text-[20px]">logout</span>
                <span>@L["Logout"]</span>
            </button>
        </form>
    </div>
</details>
