@model DelayedBranchesDto

@* VC13 · Rapor — şubeler geciken kargo sayısına göre azalan.
   "Geciken" tanımı BURADA değil, CargoRepository.WithIssue'da: bu sayı sorunlu kargolar
   listesindeki "geciken" ile aynı kargoları sayar. Gecikme VARIŞ şubesine yazılır,
   çünkü EstimatedArrivalDate bir varış taahhüdü — trafik kardeşi gibi iki ucu saymak çift sayardı.
   Boş durum bir hata değil: hiç geciken yoksa bu iyi haber. *@

<div class="m3-card p-6 mb-8">
    <h2 class="font-headline-sm text-headline-sm text-on-surface mb-4">@L["Summary_DelayedBranches"]</h2>

    @if (Model.Max == 0)
    {
        <p class="font-body-md text-body-md text-on-surface-variant">@L["Summary_NoDelayedCargo"]</p>
    }
    else
    {
        <div class="flex flex-col gap-3">
            @foreach (var sube in Model.Rows)
            {
                <div class="flex items-center gap-3">
                    <span class="w-44 shrink-0 font-body-sm text-body-sm text-on-surface truncate">@sube.BranchName</span>
                    <progress class="bar" value="@sube.DelayedCount" max="@Model.Max"></progress>
                    <span class="w-10 shrink-0 text-right font-label-md text-label-md text-on-surface">@sube.DelayedCount.ToString("N0")</span>
                </div>
            }
        </div>
    }
</div>
