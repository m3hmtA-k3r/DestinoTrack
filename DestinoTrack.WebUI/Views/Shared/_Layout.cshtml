@using System.Globalization
@{
    var culture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    var languages = new (string Code, string Label)[]
    {
        ("tr", "TR"),
        ("en", "EN"),
        ("pt", "PT")
    };
}
<!DOCTYPE html>
<html lang="@culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · DestinoTrack</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="flex min-h-screen flex-col bg-surface text-ink">

    <header class="border-b border-line bg-paper">
        <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="text-lg font-bold tracking-tight">
                Destino<span class="text-route">Track</span>
            </a>

            <div class="flex items-center gap-1">
                @foreach (var lang in languages)
                {
                    var active = lang.Code == culture;
                    <a asp-area=""
                       asp-controller="Language"
                       asp-action="Change"
                       asp-route-culture="@lang.Code"
                       asp-route-returnUrl="@returnUrl"
                       class="@(active
                                ? "rounded px-2.5 py-1 text-xs font-semibold bg-route text-white"
                                : "rounded px-2.5 py-1 text-xs font-medium text-ink-soft hover:bg-ink/5")">
                        @lang.Label
                    </a>
                }
            </div>
        </div>
    </header>

    <main class="flex-1">
        @RenderBody()
    </main>

    <footer class="border-t border-line bg-paper">
        <div class="mx-auto max-w-5xl px-6 py-6 text-sm text-ink-soft">
            <p>DestinoTrack &middot; Türkiye &middot; Malta &middot; Brasil</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
