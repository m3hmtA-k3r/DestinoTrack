@using System.Globalization
@using Microsoft.AspNetCore.Diagnostics
@{
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    // Dil değişince dönülecek adres.
    // Hata sayfalarında Request.Path iç adrestir (/Home/Error · /Home/HttpStatus/404) → kullanıcının açtığı asıl adres kullanılır 
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    var statusPage = Context.Features.Get<IStatusCodeReExecuteFeature>();
    var errorPage = Context.Features.Get<IExceptionHandlerPathFeature>();

    if (statusPage is not null)
    {
        returnUrl = statusPage.OriginalPath + statusPage.OriginalQueryString;
    }
    else if (errorPage is not null)
    {
        returnUrl = errorPage.Path;
    }
}

<!DOCTYPE html>
<html lang="@culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · DestinoTrack</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="flex min-h-screen flex-col bg-surface font-body-md text-body-md text-on-surface">

    <!--  HEADER-->
    <header class="sticky top-0 z-40 bg-surface/80 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
        <!-- max-w-7xl = 1280px  -->
        <div class="mx-auto flex h-20 max-w-7xl items-center justify-between gap-4 px-margin-mobile lg:px-margin-desktop">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-primary-container flex items-center justify-center text-on-primary shadow-sm">
                    <span class="material-symbols-outlined text-[24px]">local_shipping</span>
                </div>
                <span class="font-headline-sm text-headline-sm text-on-surface tracking-tight">DestinoTrack</span>
            </a>

            <div class="flex items-center gap-2 lg:gap-4">
                <!-- Dil seçici -->
                <div class="flex items-center p-1 rounded-xl bg-surface-container-lowest shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
                    @foreach (var lang in new[] { "tr", "en", "pt" })
                    {
                        <a asp-area="" asp-controller="Language" asp-action="Change" asp-route-culture="@lang" asp-route-returnUrl="@returnUrl"
                           class="px-2.5 py-1.5 rounded-lg text-label-md font-label-md uppercase transition-colors @(lang == culture ? "bg-secondary-container text-on-secondary-fixed" : "text-on-surface-variant hover:bg-surface-container-high")">@lang</a>
                    }
                </div>

                <!-- Hesap menüsü — ViewComponent, verisini IAccountService'ten alır -->
                @await Component.InvokeAsync("UserMenu")
            </div>

        </div>
    </header>

    
    <main class="flex-1">
        @RenderBody()
    </main>

    
    <footer class="bg-surface-container-low">
        <div class="mx-auto max-w-7xl px-margin-mobile lg:px-margin-desktop py-6">
            <p class="font-body-sm text-body-sm text-on-surface-variant">DestinoTrack &middot; Türkiye &middot; Malta &middot; Brasil</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
