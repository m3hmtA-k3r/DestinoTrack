@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-2xl font-bold text-alert">Bir şeyler ters gitti</h1>
    <p class="mt-2 text-ink-soft">İstek işlenirken bir hata oluştu.</p>

    @if (Model?.ShowRequestId ?? false)
    {
        <p class="mt-6 text-sm text-ink-soft">
            İstek numarası: <code class="code-chip">@Model.RequestId</code>
        </p>
    }
</div>
